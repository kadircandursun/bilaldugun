# Cloudflare R2 (S3 uyumlu) ayarlar\u0131
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=irem-bilal-dugun

# Foto\u011fraflar\u0131 herkese a\u00e7\u0131k servis etmek i\u00e7in R2 public bucket URL'i (opsiyonel).
# Bo\u015f b\u0131rak\u0131l\u0131rsa galeri presigned GET URL'leri kullan\u0131r.
# \u00d6rn: https://pub-xxxx.r2.dev  veya  https://foto.dugun.com
R2_PUBLIC_BASE_URL=

# Galeri şifresi (yalnızca düğün sahipleri için)
GALLERY_PASSWORD=Karamursel78*

# QR için sitenin canlı adresi (deploy sonrası doldur)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
